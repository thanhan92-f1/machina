# Machina platform control plane environment (installed by scripts/install-platform.sh).
# Override in /etc/default/machina-platform for production.

MACHINA_CONTROLLER_ID=ctrl-primary
DATABASE_URL=sqlite:///var/lib/machina/controller.db
MACHINA_AGENT_ADDR=127.0.0.1:50051
MACHINA_LIBVIRT_URI=qemu:///system
MACHINA_PUBLIC_URL=http://127.0.0.1:5093
MACHINA_WEB_URL=http://127.0.0.1:5092
RUST_LOG=info

# Shared secret for internal service-to-service platform JWTs — the
# controller mints one to pull KubeVirt inventory from the co-located
# daemon, and machina-agent mints one (read-only, "viewer" role) to pull
# sprite inventory from its co-located daemon for fleet visibility. Must be
# identical across daemon/controller/agent on a host, or those internal
# calls will be rejected. Falls back to a random per-process secret (with a
# warning) when unset, which is fine for a single dev process but breaks
# these internal syncs across daemon restarts.
# MACHINA_JWT_SECRET=<32+ random bytes, same value on daemon/controller/agent>

# Base URL of this host's co-located machina-daemon, used by both the
# controller's KubeVirt inventory sync and the agent's sprite inventory
# sync. Defaults to http://127.0.0.1:5092 (both try HTTPS first, since the
# daemon commonly runs TLS-only even on loopback).
# MACHINA_DAEMON_URL=http://127.0.0.1:5092

# Dev-only: disables ALL controller auth checks (any request is treated as admin).
# install-platform.sh only writes this line when explicitly requested
# (MACHINA_SKIP_AUTH=1 in its own environment / --require-auth omitted with that
# var set); it is NOT the tool's default. Do not uncomment for a production or
# network-reachable deployment — applies to machina-controller only. Daemon auth
# uses MACHINA_DAEMON_SKIP_AUTH in /etc/default/machina-daemon.
# MACHINA_SKIP_AUTH=1

